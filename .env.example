# === AI Model Server (Colab + ngrok) ===
AI_MODEL_URL=https://your-ngrok-url.ngrok-free.app
AI_MODEL_TIMEOUT=30
AI_MODEL_RETRIES=3

# === LLM Backend Selection (auto / local / external) ===
# auto  = try local HF model first, fall back to external API
# local = force local HF model (fail if OOM)
# external = skip local, use OpenRouter/OpenAI API only
LLM_BACKEND=auto

# === Local HuggingFace Model (runs on Colab GPU) ===
HF_MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
HF_DTYPE=float16

# === External API (OpenRouter — fallback when local model can't load) ===
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# === Database ===
DATABASE_URL=sqlite:///data/ai_dj.db

# === MusicBrainz (no API key needed — uses user-agent for rate limiting) ===
MUSICBRAINZ_USER_AGENT=AIDJSystem/0.1.0 (your-email@example.com)
MUSICBRAINZ_RATE_LIMIT=1.0

# === Optional: AudD (audio recognition) ===
AUDD_API_KEY=

# === Logging ===
LOG_LEVEL=INFO
LOG_DIR=logs

# === Audio Analysis ===
AUDIO_ANALYSIS_ENABLED=true
AUDIO_ANALYSIS_FALLBACK=metadata

# === Simulation ===
SIMULATION_SPEED=1.0
DRY_RUN=false

# === Server ===
API_HOST=0.0.0.0
API_PORT=8000
