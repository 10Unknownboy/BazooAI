# === Local Hugging Face model server (Colab + ngrok) ===
# Start the GPU notebook, then set AI_MODEL_URL to its printed ngrok URL.
AI_MODEL_URL=https://your-ngrok-url.ngrok-free.app
AI_MODEL_TIMEOUT=30
AI_MODEL_RETRIES=3

# === Database ===
DATABASE_URL=sqlite:///data/ai_dj.db

# === MusicBrainz (no API key needed — uses user-agent for rate limiting) ===
MUSICBRAINZ_USER_AGENT=AIDJSystem/0.1.0 (your-email@example.com)
MUSICBRAINZ_RATE_LIMIT=1.0

# === Optional: AudD (audio recognition) ===
AUDD_API_KEY=

# === Logging ===
LOG_LEVEL=INFO
LOG_DIR=logs

# === Audio Analysis ===
AUDIO_ANALYSIS_ENABLED=true
AUDIO_ANALYSIS_FALLBACK=metadata

# === Simulation ===
SIMULATION_SPEED=1.0
DRY_RUN=false

# === Local API server ===
API_HOST=127.0.0.1
API_PORT=8000

# === Guest request portal (started in the Streamlit process) ===
GUEST_API_HOST=0.0.0.0
GUEST_API_PORT=8003
# Set a public HTTPS tunnel URL if guests will connect over the internet.
GUEST_PUBLIC_URL=

# === Local Music ===
LOCAL_MUSIC_DIR=./music
